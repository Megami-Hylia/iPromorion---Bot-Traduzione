# Token dalla pagina Bot del Discord Developer Portal. Non condividerlo.
DISCORD_TOKEN=inserisci_il_token_del_bot
# Facoltativo: ID del server per registrare subito i comandi durante le prove.
# Vuoto = comandi globali. Riavvia il bot dopo ogni modifica a questo file.
DISCORD_GUILD_ID=

# libretranslate oppure deepl. Nessun LLM e nessun token OpenAI.
TRANSLATION_PROVIDER=libretranslate
LIBRETRANSLATE_URL=http://127.0.0.1:5000
LIBRETRANSLATE_API_KEY=
DEEPL_API_KEY=
DEEPL_API_URL=https://api-free.deepl.com

DATABASE_PATH=data/channels.sqlite3
# Le virgolette preservano lo spazio iniziale. Usa "" per il solo nome originale.
WEBHOOK_SUFFIX=" (tradotto)"
TRANSLATION_CONCURRENCY=4
CACHE_SIZE=1024
CACHE_TTL_SECONDS=600
MESSAGE_WORKERS=4
MAX_QUEUE_SIZE=200
WEBHOOK_CONCURRENCY=8
LOG_LEVEL=INFO
